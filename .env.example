# Copie este arquivo para .env e preencha com suas credenciais reais.
# NUNCA commite o arquivo .env — ele já está no .gitignore.

# Token de acesso à API Deriv
# Gere em: https://app.deriv.com/account/api-token (permissão "Read" + "Trade")
DERIV_TOKEN=pat_XXXXXXXXXXXXXXXXXXXX

# App ID registrado em: https://developers.deriv.com
DERIV_APP_ID=1089

# Modo de autenticação: "auto" detecta o tipo de token automaticamente
# Valores aceitos: auto | legacy | bearer
DERIV_AUTH_MODE=auto

# Token de autenticação do dashboard web (opcional).
# Se vazio, o acesso ao dashboard é liberado apenas para localhost.
# Defina um valor longo e aleatório para habilitar acesso remoto seguro.
DASHBOARD_TOKEN=

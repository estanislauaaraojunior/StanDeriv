{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(/.env)",
      "Read(/.env.*)",
      "Edit(/.env)",
      "Edit(/.env.*)",
      "Bash(cat .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(less .env*)",
      "Bash(more .env*)",
      "Bash(grep * .env*)",
      "Bash(*python* pipeline.py*)",
      "Bash(*python* bot.py*)",
      "Bash(*python* collector.py*)",
      "Bash(*python* dashboard/server.py*)",
      "Bash(*start.sh*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)"
    ],
    "ask": [
      "Edit(/strategy.py)",
      "Edit(/indicators.py)",
      "Edit(/config.py)",
      "Edit(/collector.py)",
      "Edit(/market_data.py)",
      "Edit(/asset_history.py)",
      "Edit(/market_calendar.py)",
      "Edit(/api_keepalive.py)",
      "Edit(/request_throttle.py)",
      "Edit(/deriv_session.py)",
      "Edit(/operational_diagnostics.py)",
      "Edit(/feature_engine.py)",
      "Edit(/executor.py)",
      "Edit(/pipeline.py)",
      "Edit(/model_contract.py)",
      "Edit(/runtime_status.py)",
      "Edit(/risk_manager.py)",
      "Edit(/docs/HOMOLOGACAO_SCORE_COLETA_2026-10-15.md)",
      "Edit(/docs/SCORE_PONDERADO_BOLLINGER.md)",
      "Edit(/state.json)",
      "Edit(/risk_state.json)",
      "Edit(/risk_accounts.json)",
      "Edit(/bot_status.json)",
      "Edit(/model_metrics.json)",
      "Edit(/shadow_state.json)",
      "Edit(/shadow_state.json.*/**)",
      "Edit(/*.pkl*)",
      "Edit(/*.csv)",
      "Edit(/*.log)",
      "Edit(/*.pid)",
      "Edit(/*.lock)",
      "Edit(/Histórico Ativos/**)",
      "Edit(/.training_inputs/**)",
      "Edit(/.training_candidates/**)",
      "Edit(/training_reports/**)",
      "Edit(/recovered_data/**)",
      "Bash(*python* train_model.py*)",
      "Bash(*python* dataset_builder.py*)",
      "Bash(*python* training_experiments.py*)",
      "Bash(*python* training_history.py*)",
      "Bash(*python* training_data.py*)",
      "Bash(*python* market_data.py*)",
      "Bash(*python* backtest.py*)",
      "Bash(*kill *)",
      "Bash(git restore*)",
      "Bash(git checkout -- *)",
      "Bash(git stash*)",
      "Bash(git push*)",
      "Bash(git commit*)"
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true
  }
}
